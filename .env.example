# 복사해서 .env로 쓴다. .env는 커밋하지 않는다.
DEV_PORT=8300
# DEV_DATA_DIR=            # 기본: <저장소>/data
# 사람 로그인을 확인할 nightshift 주소(같은 머신) / 로그인 안 됐을 때 보낼 공개 주소
DEV_NIGHTSHIFT_URL=http://127.0.0.1:8000
DEV_NIGHTSHIFT_PUBLIC_URL=https://nightshift.lomebrote.com
# Codex 검토: 서버 계정에서 codex login 후 Agents에서 만든 Codex용 키를 설정한다.
# DEV_CODEX_AGENT_KEY=
# DEV_CODEX_BIN=           # 기본: PATH의 codex (Windows npm 설치도 지원)
# DEV_CODEX_MCP_URL=       # 기본: DEV_PUBLIC_URL + /mcp/
