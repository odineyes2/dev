{
  "id": "admin-web",
  "name": "관리 도구형 웹앱",
  "description": "Python 서버와 정적 관리 화면으로 시작해요.",
  "provides": [
    "FastAPI 서버와 health",
    "nightshift 관리자 로그인",
    "SQLite 마이그레이션",
    "패밀리룩과 낮·밤 전환",
    "PM2 설정과 HTTP 검사"
  ],
  "runtime": {
    "kind": "python",
    "entry": "server/app.py"
  },
  "overwrite": [
    ".env.example"
  ],
  "options": {
    "login": {
      "name": "nightshift 로그인",
      "default": true,
      "drop": [
        "server/auth.py"
      ]
    },
    "db": {
      "name": "SQLite DB",
      "default": true,
      "drop": [
        "server/db.py"
      ]
    },
    "dark_mode": {
      "name": "다크 모드",
      "default": true,
      "drop": []
    }
  }
}
