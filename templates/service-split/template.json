{
  "id": "service-split",
  "name": "프론트·백엔드 분리형",
  "description": "Python API·워커와 정적 화면으로 시작해요.",
  "provides": [
    "FastAPI API와 readiness",
    "nightshift 관리자 로그인",
    "선택적 PostgreSQL 마이그레이션",
    "별도 워커 진입점",
    "패밀리룩과 낮·밤 전환",
    "PM2 API·워커 설정과 HTTP 검사"
  ],
  "runtime": {
    "kind": "python",
    "entry": "backend/serve.py"
  },
  "overwrite": [
    ".env.example"
  ],
  "options": {
    "login": {
      "name": "nightshift 로그인",
      "default": true,
      "drop": [
        "backend/auth.py"
      ]
    },
    "db": {
      "name": "PostgreSQL DB",
      "default": true,
      "drop": [
        "backend/db.py",
        "backend/migrations/001_core.sql"
      ]
    },
    "dark_mode": {
      "name": "다크 모드",
      "default": true,
      "drop": []
    }
  }
}
